{
  "manifest_version": 3,
  "name": "Rift",
  "short_name": "Rift",
  "description": "Send downloads, links and magnets to the Rift download manager.",
  "version": "0.0.0",
  "homepage_url": "https://rift.solarquack.in",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Rift",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "storage", "cookies", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"]
}

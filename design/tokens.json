  "motion": {
    "press": 60,
    "fast": 140,
    "base": 200,
    "slow": 300,
    "emphasized": 440,
    "tooltipDelay": 450,
    "tooltipWarm": 60,
    "rowStagger": 22,
    "easeStandard": [
      0.2,
      0.8,
      0.2,
      1
    ],
    "easeExit": [
      0.4,
      0,
      1,
      1
    ],
    "easeSpring": [
      0.2,
      1.3,
      0.3,
      1
    ],
    "pressScale": 0.965,
    "hoverLift": -1,
    "reducedMotion": "fast/base become 0, slow/emphasized become 120 ms fades; no loops (pulse, sheen, float)",
    "catalog": {
      "button": "hover: lift 1px + primary glow; press: scale .965 in 60 ms; icon nudges by meaning (plus rotates 90, refresh -180, download down 2px)",
      "sidebarItem": "hover: content slides 4px right, icon scales 1.12, count shifts left 2px",
      "row": "hover: 2px inset rule; selected: 3px accent rule; list change: rows fade-up 6px staggered 22 ms",
      "progress": "width eases (slow, standard); active downloads show a moving sheen",
      "badge": "active states (downloading, streaming, checking, metadata) show a pulsing dot",
      "tab": "underline springs in from 20 % width",
      "toggle": "thumb springs; checkbox pops 1.18x on check; press squashes 0.88",
      "menu": "scale .96 + 4px drop, spring, origin at pointer",
      "dialog": "scrim fades (base); sheet scales .965 + 8px rise (slow, spring)",
      "toast": "rises 14px with spring; 10 s drain bar pauses on hover",
      "banner": "slides down 6px (slow)",
      "tooltip": "fades + springs from 4px below after 450 ms; 60 ms when moving between neighbours",
      "emptyState": "illustration floats 6px on a 5 s loop"
    }
  },

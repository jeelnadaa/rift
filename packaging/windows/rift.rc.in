// Windows resources: app icon + version info. Configured by CMake (version comes from RIFT_VERSION).
#include <winver.h>

IDI_ICON1 ICON "@RIFT_SOURCE_DIR@/ui/assets/rift.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @RIFT_VERSION_MAJOR@,@RIFT_VERSION_MINOR@,@RIFT_VERSION_PATCH@,0
PRODUCTVERSION  @RIFT_VERSION_MAJOR@,@RIFT_VERSION_MINOR@,@RIFT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Rift"
            VALUE "FileDescription",  "Rift download manager"
            VALUE "FileVersion",      "@RIFT_VERSION@"
            VALUE "InternalName",     "Rift"
            VALUE "LegalCopyright",   "Rift contributors"
            VALUE "OriginalFilename", "Rift.exe"
            VALUE "ProductName",      "Rift"
            VALUE "ProductVersion",   "@RIFT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
